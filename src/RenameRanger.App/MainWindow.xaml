<Window x:Class="RenameRanger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RenameRanger.App.ViewModels"
        Title="Rename Ranger"
        Height="720"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:FindReplaceRuleViewModel}">
            <StackPanel Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Find" />
                    <TextBox Grid.Column="1" Margin="0,0,12,0" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="Replace" />
                    <TextBox Grid.Column="3" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <CheckBox Margin="0,8,0,0"
                          Content="Case sensitive"
                          IsChecked="{Binding CaseSensitive}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RegexRuleViewModel}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Pattern" />
                <TextBox Margin="0,4,0,0" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,8,0,0" Text="Replacement" />
                <TextBox Margin="0,4,0,0" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <CheckBox Margin="0,0,16,0"
                              Content="Case sensitive"
                              IsChecked="{Binding CaseSensitive}" />
                    <CheckBox Content="Match extension"
                              IsChecked="{Binding IncludeExtensionInMatch}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CaseRuleViewModel}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Transform" />
                <ComboBox Margin="0,4,0,0"
                          ItemsSource="{Binding Source={x:Static vm:CaseRuleViewModel.TransformOptions}}"
                          SelectedItem="{Binding Transform}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NumberingRuleViewModel}">
            <StackPanel Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Start" />
                        <TextBox Margin="0,4,0,0" Text="{Binding Start, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Step" />
                        <TextBox Margin="0,4,0,0" Text="{Binding Step, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pad width" />
                        <TextBox Margin="0,4,0,0" Text="{Binding PadWidth, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Prefix" />
                        <TextBox Margin="0,4,0,0" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Suffix" />
                        <TextBox Margin="0,4,0,0" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,8,0,0" Text="Placement" />
                <ComboBox Margin="0,4,0,0"
                          ItemsSource="{Binding Source={x:Static vm:NumberingRuleViewModel.PlacementOptions}}"
                          SelectedItem="{Binding Placement}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TrimCleanRuleViewModel}">
            <StackPanel Margin="0,8,0,0">
                <CheckBox Content="Collapse whitespace"
                          IsChecked="{Binding CollapseWhitespace}" />
                <CheckBox Margin="0,6,0,0"
                          Content="Strip bracketed tags ([...], (...))"
                          IsChecked="{Binding StripBracketedTags}" />
                <CheckBox Margin="0,6,0,0"
                          Content="Normalize separators"
                          IsChecked="{Binding NormalizeSeparators}" />
                <TextBlock Margin="0,8,0,0" Text="Normalized separator" />
                <TextBox Margin="0,4,0,0" Text="{Binding NormalizedSeparator, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MetadataTokenRuleViewModel}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Template" />
                <TextBox Margin="0,4,0,0"
                         Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Examples: {name}, {ext}, {file:modified:yyyy-MM-dd}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                Margin="0,0,0,12"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Padding="12,6"
                            Margin="0,0,8,0"
                            Click="AddFilesButton_Click"
                            Content="Add Files…" />
                    <Button Padding="12,6"
                            Margin="0,0,8,0"
                            Click="AddFolderButton_Click"
                            Content="Add Folder…" />
                    <CheckBox Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Content="Include subfolders"
                              IsChecked="{Binding IncludeSubfolders}" />
                    <Button Padding="10,6"
                            Command="{Binding ClearFilesCommand}"
                            Content="Clear Files" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ComboBox Width="180"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding RuleTypeOptions}"
                              SelectedItem="{Binding SelectedRuleType}" />
                    <Button Padding="12,6"
                            Command="{Binding AddRuleCommand}"
                            Content="Add Rule" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Files &amp; Live Preview" Margin="0,0,12,0">
                <DataGrid Margin="8"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          ItemsSource="{Binding Files}"
                          DragOver="OnDragOver"
                          Drop="OnDrop">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding OriginalFileName}"
                                            Header="Original Name"
                                            Width="2*"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Binding="{Binding ProposedFileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            Header="New Name (Preview, editable)"
                                            Width="2*"
                                            IsReadOnly="False" />

                        <DataGridTemplateColumn Header="⚠" Width="52" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="⚠"
                                               Foreground="#CC2200"
                                               Visibility="Collapsed"
                                               ToolTip="{Binding ErrorSummary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="AI" Width="78" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Padding="8,2"
                                            Command="{Binding DataContext.SuggestNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="Suggest" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="72" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Padding="8,2"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="Remove" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Rule Stack">
                    <ListBox Margin="8"
                             BorderThickness="0"
                             ItemsSource="{Binding Rules}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        BorderBrush="#22000000"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Margin="0,0,6,0"
                                                        Padding="6,2"
                                                        Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑" />
                                                <Button Margin="0,0,6,0"
                                                        Padding="6,2"
                                                        Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓" />
                                                <Button Padding="8,2"
                                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Remove" />
                                            </StackPanel>
                                        </DockPanel>

                                        <ContentControl Content="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Settings · Local AI (optional)" Margin="0,12,0,0">
                    <StackPanel Margin="10">
                        <CheckBox Content="Enable local-AI suggestions"
                                  IsChecked="{Binding IsAiEnabled}" />

                        <TextBlock Margin="0,10,0,0" Text="Endpoint URL" />
                        <TextBox Margin="0,4,0,0"
                                 Text="{Binding AiEndpointUrl, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Example: http://127.0.0.1:11434" />

                        <TextBlock Margin="0,10,0,0" Text="Model name" />
                        <TextBox Margin="0,4,0,0"
                                 Text="{Binding AiModel, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Examples: qwen2.5:1.5b, llama3.2:1b, MiniCPM-family" />

                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="#666"
                                   TextWrapping="Wrap"
                                   Text="Saved to %APPDATA%\rename-ranger\settings.json" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="10"
                Background="#FFF7F7F7"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
